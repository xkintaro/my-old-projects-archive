<% layout('layouts/main') -%>

    <div class="kintaro-ui-form-container">
        <h1 class="kintaro-ui-form-title">New Rarity</h1>

        <form class="kintaro-ui-form" action="/rarities/add_rarity" method="POST">

            <input placeholder="Rarity Index" type="number" name="rarityIndex" class="kintaro-ui-input"
                autocomplete="off" required>

            <input placeholder="Rarity Name" type="text" name="rarityName" class="kintaro-ui-input" autocomplete="off"
                required>

            <input placeholder="Rarity Image" type="text" name="rarityImage" class="kintaro-ui-input" autocomplete="off"
                required>

            <input placeholder="Rarity Icon" type="text" name="rarityIcon" class="kintaro-ui-input" autocomplete="off"
                required>

            <input placeholder="Rarity Color (e.g. #00CCFF)" type="text" name="rarityColor" class="kintaro-ui-input"
                autocomplete="off" required>

            <button type="submit" class="kintaro-button-reset kintaro-button-1 w100 accent">Add</button>
        </form>
    </div>