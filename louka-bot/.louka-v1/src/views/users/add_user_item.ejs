<% layout('layouts/main') -%>

    <div class="kintaro-ui-form-container">
        <h1 class="kintaro-ui-form-title">
            Add Item to User
            <span class="accent-text">
                <%= userId %>
            </span>
        </h1>

        <form action="/users/add_user_item/<%= userId %>" method="POST" class="kintaro-ui-form">

            <select id="itemId" name="itemId" class="kintaro-ui-input" required>
                <option value="">Select Item</option>
                <% items.forEach(item=> { %>
                    <option value="<%= item.itemId %>">

                        <img src="/img/items/<%= item.itemImage %>">

                        <%= item.itemName %>
                            (ID: <%= item.itemId %>)

                    </option>
                    <% }) %>
            </select>

            <input type="number" id="count" class="kintaro-ui-input" name="count" placeholder="Item Count" min="1"
                required>

            <button type="submit" class="kintaro-button-reset kintaro-button-1 accent w100">Add Item</button>

        </form>
    </div>