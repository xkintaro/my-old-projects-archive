<% layout('layouts/main') -%>

    <div class="kintaro-ui-form-container">
        <h1 class="kintaro-ui-form-title">New Skill</h1>

        <form class="kintaro-ui-form" action="/skills/add_skill" method="POST">

            <input placeholder="Skill Index" type="number" name="skillIndex" class="kintaro-ui-input" autocomplete="off"
                required>

            <input placeholder="Skill Name" type="text" name="skillName" class="kintaro-ui-input" autocomplete="off"
                required>

            <input placeholder="Skill Image" type="text" name="skillImage" class="kintaro-ui-input" autocomplete="off"
                required>

            <input placeholder="Skill Icon" type="text" name="skillIcon" class="kintaro-ui-input" autocomplete="off"
                required>

            <button type="submit" class="kintaro-button-reset kintaro-button-1 w100 accent">Add</button>
        </form>
    </div>